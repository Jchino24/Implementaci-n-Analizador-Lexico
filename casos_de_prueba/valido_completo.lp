// Entregable 1: declaraciones, arreglos, expresiones y comentarios.
void main() {
    int edad, contador;
    float promedio, nota1, nota2;
    char inicial;
    boolean aprobado;
    int notas[10];
    int matriz[3][3];

    edad = 20;
    contador = 0;
    nota1 = 15.5;
    nota2 = 12.25;
    promedio = (nota1 + nota2) / 2;
    inicial = "A";
    aprobado = nota1 >= nota2;
    notas[0] = 18;
    matriz[1][2] = 7;
    contador = contador + 1;
}
