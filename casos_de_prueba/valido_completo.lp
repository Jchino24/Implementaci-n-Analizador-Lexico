// Prueba integral: declaraciones, arreglos, expresiones y comentarios.
main() {
    int edad, contador;
    float promedio, nota1, nota2;
    char inicial;
    boolean aprobado;
    int[10] notas;
    int[3][3] matriz;
    int auxiliar;

    edad = 20;
    contador = 0;
    nota1 = 15.5;
    nota2 = 12.25;
    promedio = (nota1 + nota2) / 2;
    inicial = "A";
    aprobado = nota1 >= nota2;
    auxiliar = notas[0];
    auxiliar = matriz[1][2];
    contador = contador + 1;
}
